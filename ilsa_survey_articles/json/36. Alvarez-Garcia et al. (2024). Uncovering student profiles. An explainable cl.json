    "main_findings": [
      {
        "dataset_used": "PISA 2022 Spain (15-year-old students), student contextual profiles",
        "target_variable": "Student cluster membership (profile labels)",
        "top_predictors": [
          "Socioeconomic status (ESCS)",
          "ICT availability and usage at home",
          "ICT availability and usage at school",
          "Gender"
        ],
        "performance_metrics": "k-means clustering (optimal k=7); best supervised classification model reported as global accuracy = 0.8643 (test set), precision = 0.8401–0.9321, recall = 0.8055–0.9406; interpretability via global and local SHAP; SHAP indicates ESCS and ICT-use variables as highest predictive-power features.",
        "standardized_conclusion": "Using PISA 2022 Spain the study leveraged socioeconomic status (ESCS), ICT use at home and school, and gender to form and then classify student profile clusters, finding that ESCS and ICT-use variables had the highest predictive power for categorizing students. This indicates that strengthening equitable access to and regulation of ICT use—alongside targeted socioeconomic supports—may improve the identification and design of differentiated educational interventions for distinct student profiles, though the study’s clustering-to-classification pipeline is not causal and survey-weight handling is not reported."
      }
    ],
    "outcome_summary": "The study applies an explainable cluster analysis pipeline to PISA 2022 Spanish student data, using the full sample of 15-year-olds (n = 30,800) and 74 contextual variables. After preprocessing and dimensionality reduction, the authors derive 16 variables and run k-means clustering, selecting an optimal solution with 7 student clusters. They then compare supervised classification pipelines to predict cluster membership and report a best test-set global accuracy of 0.8643, with precision between 0.8401 and 0.9321 and recall between 0.8055 and 0.9406. Cluster interpretability is provided using global and local SHAP values, showing ESCS and ICT use at home and school as the most predictive features, while PISA test scores were not used for clustering. The paper is limited to a single country and does not clearly document missing-data handling or whether PISA sampling weights were incorporated, and SHAP-based importance should not be interpreted as causal effects.",
    "research_design_type": "predictive",
    "null_fields_interpretation": null
  }

    "main_findings": [
      {
        "dataset_used": "PISA 2018 Reading (Spain; students aged 15–16)",
        "target_variable": "High reading performance (Level 5–6 vs below 5)",
        "top_predictors": [
          "Enjoyment of reading (JOYREAD)",
          "Metacognition: credibility assessment (METASPAM)",
          "Reading self-concept: competence (SCREADCOMP)",
          "Reading self-concept: difficulty (SCREADDIFF)",
          "Learning time in science (SMINS)"
        ],
        "performance_metrics": "Random Forest (H2O) — best PV selected as PV9 with AUC = 0.827; contextual-only set (15 variables) AUC = 0.839 (Accuracy = 0.952); multilevel logistic regression explained variance: context-only PEV = 38.258% and process-only PEV = 40.909% (zero-inflated baseline PEV = 40.909); full model PEV ≈ 54.356% with odds ratio for METASPAM ≈ 1.989 (model 3).",
        "standardized_conclusion": "Using PISA 2018 Reading data for Spanish students, the study leveraged enjoyment of reading (JOYREAD) and metacognition (especially credibility assessment, METASPAM), along with reading self-concept and learning time, to predict high reading performance (Level 5–6). It found that process variables dominated relative importance and that the full context+process model explained about 54% of reading success, with METASPAM showing the largest effect (roughly twice the effect of key context/input indices). This indicates that strengthening reading enjoyment and metacognitive instruction (e.g., teaching students to evaluate text credibility) may increase the proportion of high-performing readers in Spain, though the study is correlational and cannot establish causality."
      }
    ],
    "outcome_summary": "The study conducts a secondary analysis of PISA 2018 reading for Spain, defining “high performance” as reaching reading levels 5–6 and modelling it as a dichotomous outcome. For variable selection and ranking, it trains a Random Forest classifier in H2O using 10-fold cross-validation and evaluates performance across plausible values, selecting PV9 as the most accurate (AUC = 0.827). It then estimates multilevel binary logistic regression models (student level 1; school level 2) after excluding schools with 20 or fewer students, using robust standard errors and reporting odds ratios and explained variance (PEV). Context-only predictors explained about 41% of variance, process-only predictors about 38–41%, and the combined model about 54.676% (PEV ≈ 54.356%). The authors emphasize that metacognition: credibility assessment is the strongest predictor (OR ≈ 1.989), but they also note that results cannot be interpreted causally and that questionnaire-based constructs may have validity limitations.",
    "research_design_type": "predictive",
    "null_fields_interpretation": null
  }
